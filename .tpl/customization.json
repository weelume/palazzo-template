{
  "$schema": "./schemas/customization.schema.json",
  "format": "git-template-customization",
  "formatVersion": "0.2.0",
  "entries": [
    {
      "id": "brand",
      "title": "品牌与价格",
      "description": "统一修改品牌、联系资料与价格。",
      "files": [
        {
          "path": "src/features/site-templates/catalog/palazzo/config.ts",
          "kind": "file",
          "purpose": "品牌和价格配置"
        }
      ],
      "constraints": [
        "双语一起更新",
        "宿主内容通过 Provider 注入"
      ],
      "checks": [
        "typecheck",
        "build"
      ]
    },
    {
      "id": "content",
      "title": "菜单与正文",
      "description": "编辑菜品、配酒、故事和政策。",
      "files": [
        {
          "path": "src/features/site-templates/catalog/palazzo/content",
          "kind": "directory",
          "purpose": "双语内容"
        }
      ],
      "constraints": [
        "同步更新双语",
        "更新过敏原声明"
      ],
      "checks": [
        "typecheck",
        "build"
      ]
    },
    {
      "id": "theme",
      "title": "主题与响应式",
      "description": "调整颜色、字体、卡片、滚动条和三端布局。",
      "files": [
        {
          "path": "src/features/site-templates/catalog/palazzo/theme.css",
          "kind": "file",
          "purpose": "主题变量和组件样式"
        }
      ],
      "constraints": [
        "保持作用域隔离",
        "尊重减少动态效果设置"
      ],
      "checks": [
        "typecheck",
        "build"
      ]
    },
    {
      "id": "motion",
      "title": "交互与动效",
      "description": "修改转桌、擦窗、横拖、座位图、礼卡和预约。",
      "files": [
        {
          "path": "src/features/site-templates/catalog/palazzo/components",
          "kind": "directory",
          "purpose": "公共交互组件"
        }
      ],
      "constraints": [
        "逐项核对 MOTION.md",
        "演示表单不得隐式发送或保存"
      ],
      "checks": [
        "typecheck",
        "lint",
        "build"
      ]
    }
  ]
}
